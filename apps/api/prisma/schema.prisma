generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model files {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  folder_id   String?  @db.Uuid
  name        String   @db.VarChar(255)
  storage_key String   @unique
  mime_type   String?  @db.VarChar(255)
  size        BigInt
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  folders     folders? @relation(fields: [folder_id], references: [id], onUpdate: NoAction, map: "fk_file_folder")
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_file_user")
  shares      shares[]

  @@index([folder_id], map: "idx_files_folder_id")
  @@index([user_id], map: "idx_files_user_id")
}

model folders {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  parent_id     String    @db.Uuid
  name          String    @db.VarChar(255)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  files         files[]
  folders       folders   @relation("foldersTofolders", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_folder_parent")
  other_folders folders[] @relation("foldersTofolders")
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_folder_user")

  @@index([parent_id], map: "idx_folders_parent_id")
  @@index([user_id], map: "idx_folders_user_id")
}

model shares {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file_id    String    @db.Uuid
  token      String    @unique
  expires_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  files      files     @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_share_file")

  @@index([file_id], map: "idx_shares_file_id")
}

model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique @db.VarChar(255)
  password_hash String
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  files         files[]
  folders       folders[]
}
